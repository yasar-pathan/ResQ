# --- Infrastructure (Docker service hostnames) ---
POSTGRES_USER=rescuegrid
POSTGRES_PASSWORD=rescuegrid
POSTGRES_DB=rescuegrid

DATABASE_URL=postgresql+asyncpg://rescuegrid:rescuegrid@postgres:5432/rescuegrid
REDIS_URL=redis://redis:6379/0

# --- Auth (set a strong secret in real deployments) ---
JWT_SECRET=change-me-in-production-use-openssl-rand
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- App ---
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
WORKER_HEALTH_PORT=8081

# --- Browser-facing URLs (published host ports, not Docker internal names) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/dashboard
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Optional until later phases ---
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
DEDUP_RADIUS_METERS=150
DEDUP_TIME_WINDOW_MINUTES=30
DELAYED_RESPONSE_THRESHOLD_MINUTES=15
CLASSIFIER_POLL_SECONDS=2
CLASSIFIER_MAX_ATTEMPTS=5

# --- Dev-only bootstrap (creates first admin when users table is empty) ---
BOOTSTRAP_ADMIN_EMAIL=admin@rescuegrid.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
